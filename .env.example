# Store secrets with `hermes config set VARIABLE_NAME value`.
# Non-secret prototype flags are applied by scripts/bootstrap-hermes.sh.
# Do not create a real .env in this repository.

# LLM routing
OPENROUTER_API_KEY=sk-or-v1-replace-me

# Telegram: create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=replace-me
# Public prototype: explicitly allow any Telegram user.
TELEGRAM_ALLOW_ALL_USERS=true
# Optional destination for cron reports and proactive notifications.
TELEGRAM_HOME_CHANNEL=123456789
TELEGRAM_HOME_CHANNEL_NAME=Cafe OS

# Voice transcription defaults to local faster-whisper. A cloud provider is
# optional; Groq is a useful low-latency alternative for a small server.
# GROQ_API_KEY=replace-me
